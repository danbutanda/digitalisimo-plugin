# Los patrones de archivos que sólo existen en la raíz se anclan con «/»: sin ancla valdrían en cualquier carpeta y
# dejarían fuera, sin aviso, archivos del tema `digitalisimo-theme/` (functions.php, style.css, assets/dist/...).
# `tests/repo-hygiene.mjs` comprueba que un tema en una subcarpeta se versiona completo.

# Paquetes generados localmente y artefactos de compilación.
*.zip
/dist/
/rollback/
/.tools/
.DS_Store

# Dependencias y archivos de desarrollo locales.
node_modules/
vendor/
# El núcleo de Elementor incluido en DIGITALÍSIMO Elements se versiona completo, también su vendor: la Release se
# compila desde el repositorio y sin él el plugin no arranca.
!digitalisimo-elements/elementor/vendor/

# Copias locales de terceros sólo para investigación; nunca se versionan ni se distribuyen. Sin ancla a propósito:
# una carpeta reference/ se ignora en cualquier nivel.
reference/
digitalisimo-elements/bdthemes-element-pack/

# Caché de Python de los scripts de análisis.
__pycache__/
