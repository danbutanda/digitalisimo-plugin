     "id": "elementor-pro-frontend-js",
     "url": "/digitalisimo-elements/assets/js/frontend(\\.min)?\\.js"
    },
    {
     "name": "widget-gallery.min.css de PRO",
     "id": "widget-gallery-css",
     "url": "/digitalisimo-elements/assets/css/widget-gallery(-rtl)?(\\.min)?\\.css"
    },
    {
     "name": "librería de galería del núcleo (script)",
     "id": "elementor-gallery-js",
     "url": "/elementor/assets/lib/e-gallery/js/"
    },
    {
     "name": "librería de galería del núcleo (hoja)",
     "id": "elementor-gallery-css",
     "url": "/elementor/assets/lib/e-gallery/css/"
    },
    {
     "name": "transiciones de PRO",
     "id": "e-transitions-css",
     "url": "/digitalisimo-elements/assets/css/conditionals/transitions(\\.min)?\\.css"
    }
   ],
   "pixels": {
    "widths": {
     "375": {
      "max": 0.6,
      "reason": "Sólo el estado hover a 375 px (normal y foco: 0,00 %): la librería de galería de PRO vuelve a colocar las imágenes con cada «resize» de la ventana (antirrebote de 300 ms y un paso intermedio con las posiciones del ancho anterior). Al medir 375 px después de 1 280 px, ese paso intermedio deja la segunda imagen bajo el puntero: en A el fondo oscuro pasa de la primera imagen a la segunda; en B (sin recolocación) queda en la primera, que es la que el puntero señala."
     }
    }
   }
  },
