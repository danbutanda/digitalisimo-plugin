    "taxonomy": "category",
    "posts_per_page": 9,
    "color_filter_active": "#245EFF"
   },
   "actions": [
    {
     "label": "filtrar por el segundo término",
     "a": ".elementor-portfolio__filter:nth-child(2)",
     "b": ".digi-portfolio__filters > li:nth-child(2) .digi-portfolio__filter",
     "wait": 2000
