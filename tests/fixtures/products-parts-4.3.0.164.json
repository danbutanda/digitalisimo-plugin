{
    "controls": {
        "digitalisimo_wc_parts_section": {
            "label": "Partes del producto",
            "name": "digitalisimo_wc_parts_section",
            "tab": "content",
            "type": "section"
        },
        "digitalisimo_wc_custom": {
            "default": "",
            "label": "Elegir qué partes mostrar",
            "name": "digitalisimo_wc_custom",
            "section": "digitalisimo_wc_parts_section",
            "tab": "content",
            "type": "switcher"
        },
        "digitalisimo_wc_parts": {
            "condition": {
                "digitalisimo_wc_custom": "yes"
            },
            "default": [
                "image",
                "title",
                "rating",
                "price",
                "cart",
                "badge"
            ],
            "label": "Partes",
            "multiple": true,
            "name": "digitalisimo_wc_parts",
            "options": {
                "image": "Imagen",
                "title": "Título",
                "excerpt": "Extracto del contenido",
                "summary": "Resumen (extracto manual o contenido)",
                "category": "Categorías",
                "rating": "Valoración",
                "price": "Precio",
                "cart": "Botón de compra",
                "readmore": "Leer más",
                "badge": "Insignia de oferta",
                "sku": "Referencia (SKU, en tabla)",
                "tags": "Etiquetas (en tabla)",
                "quantity": "Selector de cantidad (en tabla)"
            },
            "section": "digitalisimo_wc_parts_section",
            "tab": "content",
            "type": "select2"
        },
        "digitalisimo_wc_title_tag": {
            "condition": {
                "digitalisimo_wc_custom": "yes"
            },
            "default": "h2",
