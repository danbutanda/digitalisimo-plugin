                "h1": "h1",
                "h2": "h2",
                "h3": "h3",
                "h4": "h4",
                "h5": "h5",
                "h6": "h6",
                "div": "div",
                "span": "span",
                "p": "p"
            },
            "section": "digitalisimo_wc_parts_section",
            "tab": "content",
            "type": "select"
        },
        "digitalisimo_wc_excerpt_length": {
            "condition": {
                "digitalisimo_wc_custom": "yes"
