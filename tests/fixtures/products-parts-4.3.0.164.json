        "título h3 y extras": {
            "during": {
                "woocommerce_before_shop_loop_item_title": {
                    "hooks": [],
                    "output": ""
                },
                "woocommerce_shop_loop_item_title": {
                    "hooks": [
                        "10|closure"
                    ],
                    "output": "<h3 class=\"woocommerce-loop-product__title\"></h3>"
                },
                "woocommerce_after_shop_loop_item_title": {
                    "hooks": [
                        "4|closure",
                        "6|closure"
                    ],
                    "output": "<div class=\"digi-product__categories\"><a href=\"#\">Ropa</a></div><div class=\"digi-product__excerpt\">Uno dos tres cuatro cinco seis siete ocho nueve diez</div>"
                },
                "woocommerce_after_shop_loop_item": {
                    "hooks": [
                        "11|closure"
                    ],
                    "output": "<a class=\"button digi-product__readmore\" href=\"https://sitio.test/producto/\">Ver</a>"
                },
                "woocommerce_shortcode_products_query": {
                    "hooks": [],
                    "output": "{\"posts_per_page\":8}"
                }
            },
            "after": {
