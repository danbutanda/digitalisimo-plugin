    "cases": {
        "sin elegir": {
            "during": {
                "woocommerce_before_shop_loop_item_title": {
                    "hooks": [
                        "10|woocommerce_show_product_loop_sale_flash",
                        "10|woocommerce_template_loop_product_thumbnail"
                    ],
                    "output": "[woocommerce_template_loop_product_thumbnail][woocommerce_show_product_loop_sale_flash]"
                },
                "woocommerce_shop_loop_item_title": {
                    "hooks": [
                        "10|woocommerce_template_loop_product_title"
                    ],
                    "output": "[woocommerce_template_loop_product_title]"
                },
                "woocommerce_after_shop_loop_item_title": {
                    "hooks": [
                        "10|woocommerce_template_loop_price",
                        "5|woocommerce_template_loop_rating"
                    ],
                    "output": "[woocommerce_template_loop_rating][woocommerce_template_loop_price]"
                },
                "woocommerce_after_shop_loop_item": {
                    "hooks": [
                        "10|woocommerce_template_loop_add_to_cart"
                    ],
                    "output": "[woocommerce_template_loop_add_to_cart]"
                },
                "woocommerce_shortcode_products_query": {
                    "hooks": [],
                    "output": "{\"posts_per_page\":8}"
                }
            },
            "after": {
                "woocommerce_before_shop_loop_item_title": {
                    "hooks": [
                        "10|woocommerce_show_product_loop_sale_flash",
                        "10|woocommerce_template_loop_product_thumbnail"
                    ],
                    "output": "[woocommerce_template_loop_product_thumbnail][woocommerce_show_product_loop_sale_flash]"
                },
                "woocommerce_shop_loop_item_title": {
                    "hooks": [
                        "10|woocommerce_template_loop_product_title"
                    ],
                    "output": "[woocommerce_template_loop_product_title]"
                },
                "woocommerce_after_shop_loop_item_title": {
                    "hooks": [
                        "10|woocommerce_template_loop_price",
                        "5|woocommerce_template_loop_rating"
                    ],
                    "output": "[woocommerce_template_loop_rating][woocommerce_template_loop_price]"
                },
                "woocommerce_after_shop_loop_item": {
                    "hooks": [
                        "10|woocommerce_template_loop_add_to_cart"
                    ],
                    "output": "[woocommerce_template_loop_add_to_cart]"
                },
                "woocommerce_shortcode_products_query": {
                    "hooks": [],
                    "output": "{\"posts_per_page\":8}"
                }
            }
        },
